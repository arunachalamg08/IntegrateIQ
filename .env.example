# IntegrateIQ Environment Configuration
# NOTE: The frontend runs through Vite proxy and consumes zero secrets.
# All API keys, secrets, and environment parameters are loaded exclusively by the FastAPI backend.

# Environment Mode
INTEGRATEIQ_ENV=development
PORT=8000

# Google Gemini API Configuration (Official Google Gen AI SDK)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PayPal Developer Sandbox Configuration (REST API)
# Obtain from: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Test Runner Configuration
TEST_TIMEOUT_SECONDS=15
MAX_OUTPUT_BYTES=65536
